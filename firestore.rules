rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Private User Documents & Profile Settings
    // Only the authenticated account holder can read or modify their own complete profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User private subcollections (settings, privacy, audit logs)
      match /settings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Public Emergency Tokens Registry
    // First responders can only read an emergency token if it is actively enabled and not revoked.
    // The token owner can always read their own token even when suspended/revoked.
    // Only the owner who generated the token can update, deactivate, or delete it.
    match /emergency_tokens/{tokenId} {
      // Rescuers can read only if active == true and revoked != true.
      // Account owner can always read their own token for dashboard management.
      allow read: if (resource.data.active == true && (!('revoked' in resource.data) || resource.data.revoked == false))
                  || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Only the owning user can create their token record
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Only the owning user can update or deactivate their token record, and ownership cannot be transferred
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;

      // Only the owner can delete
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
